{
  "name": "punycode-bootstring-backend",
  "version": "1.0.0",
  "private": true,
  "description": "离线 RFC 3492 Punycode 编解码与插入位置解释后端（API + CLI）",
  "type": "module",
  "bin": {
    "puny": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:only": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "start": "node dist/src/cli.js serve",
    "demo": "npm run build && node dist/src/demo.js",
    "cli": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
